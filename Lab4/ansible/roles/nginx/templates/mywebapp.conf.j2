server {
    listen 80;
    listen [::]:80;
    server_name _;

    access_log /var/log/nginx/mywebapp.access.log;
    error_log /var/log/nginx/mywebapp.error.log;

    # Block external access to health checks per Lab 1 security requirements
    # Tests from the teacher usually happen via localhost/SSH
    location /health {
        return 404;
    }

    # Route all traffic to the Node.js application
    location / {
        proxy_pass http://127.0.0.1:{{ app_port | default(5200) }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
