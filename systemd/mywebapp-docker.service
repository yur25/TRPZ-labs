[Unit]
Description=My Web App Docker Container
Requires=docker.service
After=docker.service network.target

[Service]
Restart=always
TimeoutStartSec=0
ExecStartPre=-/usr/bin/docker stop mywebapp
ExecStartPre=-/usr/bin/docker rm mywebapp
ExecStart=/usr/bin/docker run --name mywebapp -p 8080:5200 ghcr.io/yur25/trpz-labs/mywebapp:latest
ExecStop=/usr/bin/docker stop mywebapp

[Install]
WantedBy=multi-user.target
